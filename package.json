{
  "name": "guard-your-mind",
  "version": "0.1.0",
  "description": "Chromium extension that blanks mature Reddit content.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md,html,css}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,html,css}\"",
    "prepare": "husky"
  },
  "keywords": [
    "chrome-extension",
    "reddit",
    "content-blocker"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@types/chrome": "^0.1.24",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,tsx,js,json,md,html,css}": [
      "prettier --check"
    ]
  }
}
